# ==========================================
# EduFlow LMS - Configuration Environment
# ==========================================

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5555

# Relational Database Engine (SQLite JDBC by default)
JDBC_URL=jdbc:sqlite:data/lms_jdbc.db

# Authentication Security
JWT_SECRET=eduflow_jwt_super_secret_key_2026_production_grade
JWT_EXPIRES_IN=30d

# ==========================================
# Google OAuth 2.0 Authentication
# ==========================================
# Obtain these credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5555/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5555/api/auth/google/callback
